---
import Gamepad2 from '@lucide/astro/icons/gamepad-2';
import Hand from '@lucide/astro/icons/hand';
import IdCard from '@lucide/astro/icons/id-card';
import Wrench from '@lucide/astro/icons/wrench';
import { verein } from '../data/verein';

const icons = { hand: Hand, gamepad: Gamepad2, wrench: Wrench, 'id-card': IdCard };
---
<section class="band">
  <div class="container">
    <p class="eyebrow">Gut zu wissen</p>
    <h2>Kein Vorwissen nötig – wir helfen dir.</h2>
    <ul>
      {verein.gutZuWissen.map((k) => {
        const Icon = icons[k.icon as keyof typeof icons];
        return (
        <li class="card">
          <span class="icon"><Icon size={26} aria-hidden="true" /></span>
          <h3>{k.titel}</h3>
          <p>{k.text}</p>
        </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: #e3f3fc; color: var(--blue-dark); }
  h3 { font-size: 1.05rem; margin: 8px 0 6px; }
  p { margin: 0; color: var(--ink-soft); font-size: .95rem; }
</style>
