---
import { Image } from 'astro:assets';
import flugplatz from '../assets/photos/flugplatz.jpeg';
import LiveTile from './LiveTile.astro';
---
<section class="hero">
  <Image src={flugplatz} alt="Der Flugplatz der MSG Übersee" data-live="hero" class="hero-img" loading="eager" fetchpriority="high" />
  <div class="shade"></div>
  <button type="button" class="cam-badge" data-live="cam-open" hidden>
    <span class="dot"></span> Live-Webcam <span data-live="cam-time"></span>
    <span class="zoom">vergrößern ⤢</span>
  </button>
  <div class="container content">
    <div>
      <h1>Selber fliegen.<br />Am Chiemsee.</h1>
      <p class="lead">Modellflug in Übersee. Komm einfach vorbei.</p>
      <a class="btn btn-lg" href="#flugplatz">So kommst du zu uns →</a>
    </div>
    <LiveTile />
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(78vh, 560px); display: flex; align-items: flex-end; padding: 0; overflow: hidden; color: #fff; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 40, 70, 0) 30%, rgba(0, 40, 70, .82)); }
  .cam-badge { position: absolute; top: 16px; right: 16px; z-index: 1; display: flex; align-items: center; gap: 8px; font: inherit; font-size: .9rem; font-weight: 700; color: #fff; background: rgba(0, 0, 0, .55); border: 0; border-radius: 999px; padding: 8px 14px; cursor: pointer; backdrop-filter: blur(4px); }
  .cam-badge[hidden] { display: none; }
  .cam-badge:hover { background: rgba(0, 0, 0, .75); }
  .cam-badge .zoom { font-weight: 600; opacity: .85; padding-left: 8px; border-left: 1px solid rgba(255, 255, 255, .35); }
  .dot { width: .65em; height: .65em; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 0 rgba(214, 69, 69, .7); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(214, 69, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(214, 69, 69, 0); } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  .content { position: relative; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-end; padding-block: 32px; }
  h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); font-weight: 800; }
  .lead { font-size: 1.1rem; opacity: .92; margin: 10px 0 18px; }
</style>
